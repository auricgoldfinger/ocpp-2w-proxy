meta {
  name: ReserveNow
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/debug/chargers/{{chargerId}}/commands
  body: json
  auth: none
}

body:json {
  {
    "action": "ReserveNow",
    "payload": {
      "connectorId": 1,
      "expiryDate": "2030-01-01T12:00:00Z",
      "idTag": "TESTTAG",
      "reservationId": 1
    },
    "timeout": {{timeout}}
  }
}

assert {
  res.status: eq 200
}

docs {
  Reserves a connector for an idTag.

  Side effects / persistence: Reservation is stored on the charger until expiry or cancel.

  Status 200 only means the proxy delivered the command; check the body for CallResult/CallError. 'Accepted' means stored, not applied.
}
