meta {
  name: SendLocalList
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/debug/chargers/{{chargerId}}/commands
  body: json
  auth: none
}

body:json {
  {
    "action": "SendLocalList",
    "payload": {
      "listVersion": 1,
      "updateType": "Differential",
      "localAuthorizationList": [
        {
          "idTag": "TESTTAG",
          "idTagInfo": {
            "status": "Accepted"
          }
        }
      ]
    },
    "timeout": {{timeout}}
  }
}

assert {
  res.status: eq 200
}

docs {
  Updates the local authorization list.

  Side effects / persistence: Persisted by the charger; affects offline authorization.

  Status 200 only means the proxy delivered the command; check the body for CallResult/CallError. 'Accepted' means stored, not applied.
}
