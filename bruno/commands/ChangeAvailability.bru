meta {
  name: ChangeAvailability
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/debug/chargers/{{chargerId}}/commands
  body: json
  auth: none
}

body:json {
  {
    "action": "ChangeAvailability",
    "payload": {
      "connectorId": 1,
      "type": "Operative"
    },
    "timeout": {{timeout}}
  }
}

assert {
  res.status: eq 200
}

docs {
  Sets a connector (0 = whole charger) Operative or Inoperative.

  Side effects / persistence: Persisted by the charger across reboots. Inoperative blocks charging; may be Scheduled if a transaction is running.

  Status 200 only means the proxy delivered the command; check the body for CallResult/CallError. 'Accepted' means stored, not applied.
}
