meta {
  name: GetLocalListVersion
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/debug/chargers/{{chargerId}}/commands
  body: json
  auth: none
}

body:json {
  {
    "action": "GetLocalListVersion",
    "payload": {},
    "timeout": {{timeout}}
  }
}

assert {
  res.status: eq 200
}

docs {
  Reads the version of the local authorization list.

  Side effects / persistence: Read-only.

  Status 200 only means the proxy delivered the command; check the body for CallResult/CallError. 'Accepted' means stored, not applied.
}
