meta {
  name: ClearChargingProfile
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/debug/chargers/{{chargerId}}/commands
  body: json
  auth: none
}

body:json {
  {
    "action": "ClearChargingProfile",
    "payload": {
      "connectorId": 1,
      "chargingProfilePurpose": "TxDefaultProfile",
      "stackLevel": 1
    },
    "timeout": {{timeout}}
  }
}

assert {
  res.status: eq 200
}

docs {
  Removes charging profiles matching the filters.

  Side effects / persistence: Stored profiles are deleted (they are normally persisted by the charger).

  Status 200 only means the proxy delivered the command; check the body for CallResult/CallError. 'Accepted' means stored, not applied.

  HARDWARE RISK: An EMPTY payload ({}) removes ALL profiles, including any load-balancing cap, so the charger may draw full rating. Always keep at least one filter.
}
