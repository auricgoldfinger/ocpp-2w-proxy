meta {
  name: GetDiagnostics
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/debug/chargers/{{chargerId}}/commands
  body: json
  auth: none
}

body:json {
  {
    "action": "GetDiagnostics",
    "payload": {
      "location": "ftp://example.invalid/diagnostics/",
      "retries": 1,
      "retryInterval": 60
    },
    "timeout": {{timeout}}
  }
}

assert {
  res.status: eq 200
}

docs {
  Tells the charger to upload a diagnostics file to the given URI.

  Side effects / persistence: Charger uploads a file and sends DiagnosticsStatusNotification messages (these reach the backend).

  Status 200 only means the proxy delivered the command; check the body for CallResult/CallError. 'Accepted' means stored, not applied.

  HARDWARE RISK: The charger connects to an arbitrary URL and may upload logs containing secrets. Use only a server you control.
}
