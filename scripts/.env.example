# Copy to .env (gitignored) next to pause_resume_test.py and fill in.

# Full idTag of your Tap card as Tap knows it (the proxy log only shows the last 4 characters).
TAP_ID_TAG=

# Defaults; only set these if they differ.
# PROXY_DEBUG_URL=http://192.168.0.10:8322
# CHARGER_ID=99224881
# CHARGER_IP=192.168.0.222

# For `stop` without a txId, `check` and `log`: ssh access to the NAS (reads the proxy's state
# file and monitor.sqlite, no sudo needed). Taken from ../.env.build when not set here.
# NAS_SSH_HOST=admin@192.168.0.10
# PROXY_DATA_DIR=/mnt/volume/apps/ocpp-2w-proxy/data
