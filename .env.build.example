# Copy to .env.build (gitignored) next to build-and-deploy.sh and adjust.
# Sourced by the script; every value can also be passed as an environment variable.

# SSH target of the NAS, e.g. admin@truenas.local or admin@10.0.0.5
NAS_SSH_HOST=admin@truenas.local

# Absolute path on the NAS the image tarball is copied to
NAS_TMP_DIR=/tmp

# Optional:
# VERSION=2026-10-09        # image tag (default: today's date, YYYY-MM-DD)
# IMAGE_NAME=ocpp-2w-proxy
# PLATFORM=linux/amd64
# SKIP_TESTS=1
